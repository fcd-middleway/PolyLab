# Simple cube for testing
# 8 vertices, 12 triangles (2 per face)

v -1.0 -1.0 -1.0
v -1.0 -1.0  1.0
v -1.0  1.0 -1.0
v -1.0  1.0  1.0
v  1.0 -1.0 -1.0
v  1.0 -1.0  1.0
v  1.0  1.0 -1.0
v  1.0  1.0  1.0

# Left face
f 1 2 3
f 3 2 4

# Right face
f 5 7 6
f 6 7 8

# Bottom face
f 1 5 2
f 2 5 6

# Top face
f 3 4 7
f 4 8 7

# Back face
f 1 3 5
f 3 7 5

# Front face
f 2 6 4
f 4 6 8
